<Project Sdk="Microsoft.NET.Sdk">

  <!--
    仅用于验证 source-only 包是否真的被正确引入：本工程没有 <Import> 任何 props，
    也没有手写 lazer 的 <Reference>，全部由包内的 buildTransitive props 提供。
    运行前先执行：dotnet pack OsuLazer.Interop/OsuLazer.Interop.csproj
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OsuLazer.Interop" Version="*" />
  </ItemGroup>

</Project>
